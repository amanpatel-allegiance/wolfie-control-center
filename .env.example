# Wolfie Control Center — env vars
# Never commit real values. Copy this file to .env.local and fill in.

# Supabase — Projects DB (pqzsdxcjyqjjvfsunzak)
NEXT_PUBLIC_SUPABASE_URL=https://pqzsdxcjyqjjvfsunzak.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose to the browser. Used by API routes for privileged writes.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub PAT with `repo` + `workflow` scopes for workflow_dispatch on the 3 GH-Actions repos:
#   wolfie-ajman-sync, wolfie-sharjah-sync, wolfie-geniemap-sync
# The dld-ingest + adinteract-sync repos run on private machines and are dispatched manually.
GITHUB_DISPATCH_TOKEN=

# Slack webhook (optional). Alert engine posts to this if set.
SLACK_ALERT_WEBHOOK=

# Cron shared secret. Vercel Cron / external cron send this in `Authorization: Bearer …`.
ALERT_TICK_SECRET=

# App base URL for absolute links in alert payloads.
APP_BASE_URL=http://localhost:2085
